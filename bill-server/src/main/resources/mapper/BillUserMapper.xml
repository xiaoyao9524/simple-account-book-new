<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xy.simple_accountbook.bill.mapper.BillUserMapper">
    <resultMap id="billUserResultMap" type="com.xy.simple_accountbook.bill.entity.BillUserEntity">
        <id column="id" property="id"/>
        <result column="bill_id" property="billId"/>
        <result column="u_id" property="uId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted_at" property="deletedAt" />
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="billUserEntity.id">
        INSERT INTO bill_user (bill_id, u_id)
        VALUES (#{billUserEntity.billId}, #{billUserEntity.uId})
    </insert>

    <select id="queryByUId" resultMap="billUserResultMap">
        SELECT id, bill_id, u_id
        FROM bill_user
        WHERE u_id = #{uId}
        AND deleted_at IS NULL
    </select>

    <select id="queryByBillIdsAndUId" resultMap="billUserResultMap">
        SELECT id, bill_id, u_id, create_time, update_time
        FROM bill_user
        WHERE bill_id IN
        <foreach collection="billIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND deleted_at IS NULL
        AND u_id = #{uId}
    </select>

    <select id="findByBillIdAndUId" resultMap="billUserResultMap">
        SELECT id, bill_id, u_id, create_time, update_time
        FROM bill_user
        WHERE bill_id = #{billId}
          AND deleted_at IS NULL
          AND u_id = #{uId}
    </select>

    <update id="batchDeleteByIdsAndUId">
        UPDATE bill_user
        SET deleted_at = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND u_id = #{uId}
        AND deleted_at IS NULL
    </update>

    <select id="queryBillCount" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM bill_user bu
        INNER JOIN bill b ON bu.bill_id = b.id AND b.deleted_at IS NULL
        WHERE bu.u_id = #{uId}
        AND bu.deleted_at IS NULL
    </select>
</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xy.simple_accountbook.bill.mapper.BillMapper">
    <resultMap id="categoryResultMap" type="com.xy.simple_accountbook.bill.entity.BillEntity">
        <id column="id" property="id"/>
        <result column="category_id" property="categoryId"/>
        <result column="type" property="type"
                typeHandler="com.xy.simple_accountbook.bill.handler.CategoryTypeHandler"/>
        <result column="price" property="price"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted_at" property="deletedAt" />
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="bill.id">
        INSERT INTO bill (type, category_id, price, remark, date)
        VALUES (#{bill.type}, #{bill.categoryId}, #{bill.price}, #{bill.remark}, #{bill.date})
    </insert>
</mapper>
